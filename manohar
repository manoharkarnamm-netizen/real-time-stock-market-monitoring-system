<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MarketWatch Pro</title>

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --background: #f4f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #718096;
      --border: #e1e7ef;
      --green: #159957;
      --red: #dc3545;
      --yellow: #d99400;
      --soft-blue: #eaf2ff;
      --purple: #7c3aed;
    }

    body.dark {
      --background: #101827;
      --card: #182235;
      --text: #f4f7fb;
      --muted: #a9b5c7;
      --border: #334155;
      --soft-blue: #1e3a63;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: var(--background);
      color: var(--text);
      transition: background 0.3s, color 0.3s;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 17px 6%;
      background: var(--card);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand {
      color: var(--primary);
      font-size: 24px;
      font-weight: bold;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    nav a {
      color: var(--text);
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      color: var(--primary);
    }

    button {
      font-family: inherit;
    }

    .nav-button,
    .theme-button,
    .api-button,
    .login-button,
    .logout-button {
      border: none;
      border-radius: 7px;
      padding: 10px 13px;
      cursor: pointer;
      font-weight: bold;
    }

    .nav-button {
      background: var(--primary);
      color: white;
    }

    .theme-button,
    .api-button {
      background: var(--soft-blue);
      color: var(--text);
    }

    .login-button {
      background: var(--purple);
      color: white;
    }

    .logout-button {
      display: none;
      background: var(--red);
      color: white;
    }

    #userDisplay {
      display: none;
      color: var(--primary);
      font-size: 14px;
      font-weight: bold;
    }

    .dashboard {
      width: 90%;
      max-width: 1450px;
      margin: 30px auto;
    }

    .dashboard-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
    }

    .dashboard-title h1 {
      font-size: 34px;
      margin-bottom: 8px;
    }

    .dashboard-title p {
      color: var(--muted);
    }

    .market-status {
      padding: 12px 16px;
      border-radius: 8px;
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--green);
      font-weight: bold;
      white-space: nowrap;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 25px;
    }

    .summary-card {
      padding: 20px;
      border-radius: 12px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    }

    .summary-card p {
      color: var(--muted);
      margin-bottom: 10px;
      font-size: 14px;
    }

    .summary-card h2 {
      font-size: 25px;
    }

    .positive {
      color: var(--green) !important;
    }

    .negative {
      color: var(--red) !important;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 22px;
      align-items: start;
    }

    .card {
      padding: 22px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .card-header h2 {
      font-size: 21px;
    }

    .search-box {
      width: 240px;
      padding: 11px;
      border: 1px solid var(--border);
      border-radius: 7px;
      outline: none;
      background: var(--background);
      color: var(--text);
    }

    .search-box:focus,
    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
    }

    .stock-table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 700px;
    }

    th,
    td {
      padding: 15px 10px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--muted);
      font-size: 13px;
      text-transform: uppercase;
    }

    td {
      font-size: 14px;
    }

    .company-name {
      color: var(--muted);
      font-size: 12px;
      margin-top: 5px;
    }

    .star-button {
      border: none;
      background: transparent;
      color: #c1c8d2;
      cursor: pointer;
      font-size: 20px;
    }

    .star-button.active {
      color: #f2b01e;
    }

    .details-button,
    .alert-button,
    .small-button {
      border: none;
      border-radius: 5px;
      padding: 8px 10px;
      background: var(--primary);
      color: white;
      cursor: pointer;
      font-size: 12px;
    }

    .details-button:hover,
    .alert-button:hover,
    .small-button:hover {
      background: var(--primary-dark);
    }

    .watchlist {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .watch-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px;
      border-radius: 8px;
      background: var(--background);
      border: 1px solid var(--border);
      cursor: pointer;
    }

    .watch-item:hover {
      border-color: var(--primary);
    }

    .watch-symbol {
      font-weight: bold;
      color: var(--primary);
    }

    .watch-price {
      margin-top: 4px;
      font-size: 13px;
    }

    .watch-change {
      font-size: 13px;
      font-weight: bold;
    }

    .empty-box {
      padding: 20px;
      text-align: center;
      color: var(--muted);
    }

    .chart-card,
    .portfolio-card,
    .alerts-card,
    .news-card {
      margin-top: 22px;
    }

    #stockChart {
      width: 100%;
      height: 300px;
      display: block;
      border-radius: 8px;
      background: var(--background);
    }

    .selected-stock {
      color: var(--primary);
    }

    .portfolio-form,
    .alert-form {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
      gap: 10px;
      margin-bottom: 18px;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 11px;
      border: 1px solid var(--border);
      border-radius: 6px;
      outline: none;
      background: var(--background);
      color: var(--text);
    }

    .calculate-button {
      padding: 11px 15px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      color: white;
      background: var(--primary);
      font-weight: bold;
    }

    .portfolio-result {
      padding: 15px;
      border-radius: 7px;
      background: var(--soft-blue);
      color: var(--text);
      line-height: 1.8;
    }

    .alerts-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .alert-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      padding: 14px;
      border-radius: 8px;
      background: var(--background);
      border: 1px solid var(--border);
    }

    .alert-symbol {
      color: var(--primary);
      font-weight: bold;
    }

    .delete-alert {
      border: none;
      background: transparent;
      color: var(--red);
      cursor: pointer;
      font-size: 18px;
    }

    .news-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .news-item {
      padding: 16px;
      border-radius: 8px;
      background: var(--background);
      border: 1px solid var(--border);
    }

    .news-item h3 {
      font-size: 16px;
      margin-bottom: 10px;
    }

    .news-item p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }

    .news-date {
      color: var(--primary);
      display: block;
      font-size: 12px;
      margin-top: 12px;
    }

    .api-note {
      margin-top: 20px;
      padding: 15px;
      border-left: 4px solid var(--yellow);
      background: rgba(217, 148, 0, 0.1);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 50;
      padding: 25px;
      background: rgba(0, 0, 0, 0.65);
      overflow-y: auto;
    }

    .modal-content {
      width: 100%;
      max-width: 600px;
      margin: auto;
      padding: 25px;
      border-radius: 12px;
      background: var(--card);
      position: relative;
    }

    .close-button {
      position: absolute;
      right: 15px;
      top: 10px;
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: 30px;
      cursor: pointer;
    }

    .modal-content h2 {
      color: var(--primary);
      margin-bottom: 18px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 13px 0;
      border-bottom: 1px solid var(--border);
    }

    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .auth-form label {
      margin-top: 7px;
      font-weight: bold;
    }

    .auth-message {
      min-height: 20px;
      color: var(--red);
      font-size: 14px;
    }

    .switch-auth {
      margin-top: 15px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    .switch-auth button {
      border: none;
      background: transparent;
      color: var(--primary);
      cursor: pointer;
      font-weight: bold;
    }

    footer {
      margin-top: 30px;
      padding: 22px;
      text-align: center;
      background: #111827;
      color: white;
    }

    @media (max-width: 1100px) {
      .summary-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .main-grid {
        grid-template-columns: 1fr;
      }

      .news-list {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 700px) {
      header {
        padding: 15px 4%;
      }

      nav {
        gap: 7px;
      }

      nav a,
      #userDisplay {
        display: none !important;
      }

      .dashboard {
        width: 94%;
      }

      .dashboard-title {
        align-items: flex-start;
        flex-direction: column;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }

      .card-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .search-box {
        width: 100%;
      }

      .portfolio-form,
      .alert-form {
        grid-template-columns: 1fr;
      }

      .news-list {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="brand">📈 MarketWatch Pro</div>

    <nav>
      <a href="#dashboard">Dashboard</a>
      <a href="#watchlistSection">Watchlist</a>
      <a href="#alertsSection">Alerts</a>
      <a href="#newsSection">News</a>

      <span id="userDisplay"></span>

      <button id="loginButton" class="login-button">
        Login
      </button>

      <button id="logoutButton" class="logout-button">
        Logout
      </button>

      <button id="themeButton" class="theme-button">
        🌙 Dark
      </button>

      <button id="apiButton" class="api-button">
        API
      </button>
    </nav>
  </header>

  <main id="dashboard" class="dashboard">

    <div class="dashboard-title">
      <div>
        <h1>Stock Market Dashboard</h1>
        <p>Monitor stocks, alerts, portfolio performance and news.</p>
      </div>

      <div id="marketStatus" class="market-status">
        ● Demo Market Data
      </div>
    </div>

    <section class="summary-grid">
      <div class="summary-card">
        <p>Market Index</p>
        <h2 id="indexValue">22,450.30</h2>
      </div>

      <div class="summary-card">
        <p>Today's Change</p>
        <h2 id="indexChange" class="positive">+1.28%</h2>
      </div>

      <div class="summary-card">
        <p>Advancing Stocks</p>
        <h2 id="advancingStocks" class="positive">1,245</h2>
      </div>

      <div class="summary-card">
        <p>Declining Stocks</p>
        <h2 id="decliningStocks" class="negative">732</h2>
      </div>
    </section>

    <div class="main-grid">

      <section class="card">
        <div class="card-header">
          <h2>Market Stocks</h2>

          <input
            type="text"
            id="searchInput"
            class="search-box"
            placeholder="Search symbol or company..."
          >
        </div>

        <div class="stock-table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Watch</th>
                <th>Stock</th>
                <th>Price</th>
                <th>Change</th>
                <th>Volume</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody id="stockTableBody"></tbody>
          </table>
        </div>
      </section>

      <section id="watchlistSection" class="card">
        <div class="card-header">
          <h2>My Watchlist</h2>
        </div>

        <div id="watchlist" class="watchlist"></div>
      </section>

    </div>

    <section class="card chart-card">
      <div class="card-header">
        <h2>
          Price Chart:
          <span id="selectedStock" class="selected-stock">AAPL</span>
        </h2>

        <button id="refreshButton" class="api-button">
          🔄 Refresh
        </button>
      </div>

      <canvas id="stockChart"></canvas>
    </section>

    <section class="card portfolio-card">
      <div class="card-header">
        <h2>Portfolio Calculator</h2>
      </div>

      <div class="portfolio-form">
        <input
          type="text"
          id="portfolioSymbol"
          placeholder="Symbol e.g. AAPL"
        >

        <input
          type="number"
          id="portfolioQuantity"
          placeholder="Quantity"
          min="1"
        >

        <input
          type="number"
          id="portfolioBuyPrice"
          placeholder="Buy price"
          min="0"
        >

        <button id="calculateButton" class="calculate-button">
          Calculate
        </button>
      </div>

      <div id="portfolioResult" class="portfolio-result">
        Enter stock details to calculate your investment value.
      </div>
    </section>

    <section id="alertsSection" class="card alerts-card">
      <div class="card-header">
        <h2>Price Alerts</h2>
        <button id="notificationButton" class="api-button">
          Enable Notifications
        </button>
      </div>

      <div class="alert-form">
        <select id="alertSymbol"></select>

        <select id="alertType">
          <option value="above">Price goes above</option>
          <option value="below">Price goes below</option>
        </select>

        <input
          type="number"
          id="alertPrice"
          placeholder="Target price"
          min="0"
          step="0.01"
        >

        <button id="addAlertButton" class="calculate-button">
          Add Alert
        </button>
      </div>

      <div id="alertsList" class="alerts-list"></div>
    </section>

    <section id="newsSection" class="card news-card">
      <div class="card-header">
        <h2>Market News</h2>

        <button id="refreshNewsButton" class="api-button">
          Refresh News
        </button>
      </div>

      <div id="newsList" class="news-list"></div>
    </section>

    <div class="api-note">
      <strong>Demo mode:</strong>
      The dashboard works with simulated market prices by default.
      You can add a Finnhub API key using the API button to request
      quote data. This project is for education and is not financial advice.
    </div>

  </main>

  <!-- Stock Details Modal -->
  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button id="closeDetails" class="close-button">&times;</button>
      <h2 id="detailsTitle">Stock Details</h2>
      <div id="stockDetails"></div>
    </div>
  </div>

  <!-- API Modal -->
  <div id="apiModal" class="modal">
    <div class="modal-content">
      <button id="closeApi" class="close-button">&times;</button>

      <h2>API Settings</h2>

      <p style="color: var(--muted); line-height: 1.6; margin-bottom: 15px;">
        Enter a Finnhub API key to request live quote data.
        Leave it empty to use demo mode.
      </p>

      <input
        type="password"
        id="apiKeyInput"
        placeholder="Enter Finnhub API key"
      >

      <br><br>

      <button id="saveApiKey" class="calculate-button">
        Save API Key
      </button>

      <button id="clearApiKey" class="api-button">
        Use Demo Mode
      </button>

      <p id="apiMessage" style="margin-top: 15px; color: var(--muted);"></p>
    </div>
  </div>

  <!-- Login Modal -->
  <div id="authModal" class="modal">
    <div class="modal-content">
      <button id="closeAuth" class="close-button">&times;</button>

      <h2 id="authTitle">Login</h2>

      <form id="authForm" class="auth-form">
        <div id="nameField" style="display: none;">
          <label for="authName">Name</label>
          <input type="text" id="authName">
        </div>

        <label for="authEmail">Email</label>
        <input type="email" id="authEmail" required>

        <label for="authPassword">Password</label>
        <input
          type="password"
          id="authPassword"
          minlength="4"
          required
        >

        <p id="authMessage" class="auth-message"></p>

        <button type="submit" class="calculate-button">
          Login
        </button>
      </form>

      <div class="switch-auth">
        <span id="switchText">Don't have an account?</span>
        <button id="switchAuth" type="button">Register</button>
      </div>
    </div>
  </div>

  <footer>
    <p>© 2026 MarketWatch Pro | Educational stock dashboard</p>
  </footer>

