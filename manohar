    function createChartValues(stock) {
      const values = [];
      let current = stock.price - stock.change * 2.5;

      for (let i = 0; i < 30; i++) {
        current +=
          (Math.random() - 0.48) *
          stock.price *
          0.012;

        values.push(Number(current.toFixed(2)));
      }

      values[values.length - 1] = stock.price;

      return values;
    }

    function drawChart(symbol) {
      const stock = stocks.find(function(item) {
        return item.symbol === symbol;
      });

      if (!stock) {
        return;
      }

      const canvas = stockChart;
      const context = canvas.getContext("2d");
      const ratio = window.devicePixelRatio || 1;

      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      canvas.width = width * ratio;
      canvas.height = height * ratio;

      context.scale(ratio, ratio);
      context.clearRect(0, 0, width, height);

      const values = createChartValues(stock);
      const minValue = Math.min(...values);
      const maxValue = Math.max(...values);

      const padding = 35;
      const chartWidth = width - padding * 2;
      const chartHeight = height - padding * 2;

      const lineColor =
        stock.change >= 0
          ? "#159957"
          : "#dc3545";

      const borderColor =
        getComputedStyle(document.body)
          .getPropertyValue("--border");

      context.strokeStyle = borderColor;
      context.lineWidth = 1;

      for (let i = 0; i < 5; i++) {
        const y =
          padding + (chartHeight / 4) * i;

        context.beginPath();
        context.moveTo(padding, y);
        context.lineTo(width - padding, y);
        context.stroke();
      }

      context.beginPath();

      values.forEach(function(value, index) {
        const x =
          padding +
          (index / (values.length - 1)) *
          chartWidth;

        const y =
          padding +
          ((maxValue - value) /
            (maxValue - minValue || 1)) *
          chartHeight;

        if (index === 0) {
          context.moveTo(x, y);
        } else {
          context.lineTo(x, y);
        }
      });

      context.strokeStyle = lineColor;
      context.lineWidth = 3;
      context.stroke();

      context.lineTo(width - padding, height - padding);
      context.lineTo(padding, height - padding);
      context.closePath();

      const gradient =
        context.createLinearGradient(
          0,
          padding,
          0,
          height - padding
        );

      gradient.addColorStop(
        0,
        stock.change >= 0
          ? "rgba(21,153,87,0.25)"
          : "rgba(220,53,69,0.25)"
      );

      gradient.addColorStop(1, "rgba(0,0,0,0)");

      context.fillStyle = gradient;
      context.fill();

      context.fillStyle =
        getComputedStyle(document.body)
          .getPropertyValue("--muted");

      context.font = "12px Arial";

      context.fillText(
        "₹" + formatNumber(maxValue),
        5,
        padding
      );

      context.fillText(
        "₹" + formatNumber(minValue),
        5,
        height - padding
      );
    }

