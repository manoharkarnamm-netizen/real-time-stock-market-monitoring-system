    function checkAlerts() {
      alerts.forEach(function(alert) {
        const stock = stocks.find(function(item) {
          return item.symbol === alert.symbol;
        });

        if (!stock) {
          return;
        }

        const triggered =
          alert.type === "above"
            ? stock.price >= alert.price
            : stock.price <= alert.price;

        if (triggered) {
          sendNotification(
            "Price Alert: " + alert.symbol,
            alert.symbol +
            " reached ₹" +
            formatNumber(stock.price)
          );
        }
      });
    }

