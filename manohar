    function calculatePortfolio() {
      const symbol =
        portfolioSymbol.value.trim().toUpperCase();

      const quantity =
        Number(portfolioQuantity.value);

      const buyPrice =
        Number(portfolioBuyPrice.value);

      const stock = stocks.find(function(item) {
        return item.symbol === symbol;
      });

      if (!stock) {
        portfolioResult.textContent =
          "Stock symbol not found.";
        return;
      }

      if (quantity <= 0 || buyPrice <= 0) {
        portfolioResult.textContent =
          "Enter valid quantity and buy price.";
        return;
      }

      const invested =
        quantity * buyPrice;

      const current =
        quantity * stock.price;

      const profitLoss =
        current - invested;

      const profitLossPercent =
        (profitLoss / invested) * 100;

      const resultClass =
        profitLoss >= 0
          ? "positive"
          : "negative";

      portfolioResult.innerHTML = `
        <p><strong>Stock:</strong> ${stock.symbol}</p>
        <p><strong>Quantity:</strong> ${quantity}</p>
        <p><strong>Invested Amount:</strong>
          ₹${formatNumber(invested)}
        </p>
        <p><strong>Current Value:</strong>
          ₹${formatNumber(current)}
        </p>
        <p class="${resultClass}">
          <strong>Profit/Loss:</strong>
          ${profitLoss >= 0 ? "+" : ""}
          ₹${formatNumber(profitLoss)}
          (${profitLoss >= 0 ? "+" : ""}
          ${formatNumber(profitLossPercent)}%)
        </p>
      `;
    }

