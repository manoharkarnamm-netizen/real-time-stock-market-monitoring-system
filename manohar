    async function loadLiveQuotes() {
      if (!API_KEY) {
        document.getElementById("marketStatus")
          .textContent = "● Demo Market Data";
        return;
      }

      document.getElementById("marketStatus")
        .textContent = "● Loading Live Data...";

      for (const stock of stocks) {
        try {
          const url =
            "https://finnhub.io/api/v1/quote" +
            "?symbol=" +
            encodeURIComponent(stock.symbol) +
            "&token=" +
            encodeURIComponent(API_KEY);

          const response = await fetch(url);
          const data = await response.json();

          if (data && data.c) {
            stock.price = data.c;
            stock.change = data.d;
            stock.changePercent = data.dp;
            stock.high = data.h;
            stock.low = data.l;
            stock.open = data.o;
            stock.previousClose = data.pc;
          }
        } catch (error) {
          console.error(error);
        }
      }

      document.getElementById("marketStatus")
        .textContent = "● Live API Data";

      refreshScreen();
    }

